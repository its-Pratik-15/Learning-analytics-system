# Frontend Environment Variables

# Backend API URL
# Local development
REACT_APP_API_URL=http://localhost:8000

# Production (Render)
# REACT_APP_API_URL=https://ai-study-coach-backend.onrender.com

# App name
REACT_APP_NAME=AI Study Coach

